# Angel One SmartAPI credentials — fill these in when your demat account is ready.
# Get from https://smartapi.angelbroking.com/ after account approval.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Data source: "mock" or "angel"
DATA_SOURCE=mock

# Symbols to track (comma-separated NSE symbols)
SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Storage
TICK_STORE_DIR=./data/ticks
PARQUET_ROLL_MINUTES=15

# Redis (optional — falls back to in-memory dict if unreachable)
REDIS_URL=redis://localhost:6379/0
