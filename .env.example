# ---------------------------------------------------------------------------
# Market Microstructure Analyzer — example environment file.
# Copy to .env and fill in as needed. .env is gitignored; .env.example is not.
# ---------------------------------------------------------------------------

# --- Data source -----------------------------------------------------------
# "mock" runs the seedable synthetic feed. "angel" uses the Angel One
# SmartAPI adapter (currently a stub — see backend/ingestion/angel_source.py).
DATA_SOURCE=mock

# Symbols to track (comma-separated NSE symbols).
SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK

# Angel One credentials — required only when DATA_SOURCE=angel.
# Never commit real credentials.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# --- HTTP ------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS: comma-separated list of allowed origins, or "*" (dev only).
# Production example: CORS_ALLOW_ORIGINS=https://dash.example.com
CORS_ALLOW_ORIGINS=*

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
# Set LOG_JSON=1 in production so logs ship cleanly to your aggregator.
LOG_JSON=0

# --- Auth & rate limiting --------------------------------------------------
# Shared-secret token WS clients must pass as ?token=... on the WebSocket URL.
# Leave empty in dev; set to a long random string before deploying publicly.
WS_AUTH_TOKEN=
# HTTP requests per client-IP per minute. 0 disables the limiter (dev only).
HTTP_RATE_LIMIT_PER_MINUTE=120

# --- Storage ---------------------------------------------------------------
TICK_STORE_DIR=./data/ticks
PARQUET_ROLL_MINUTES=15

# --- Redis (optional) ------------------------------------------------------
# Falls back to an in-memory dict if unreachable. Set to an empty string to
# skip Redis entirely (useful for local runs without docker-compose).
REDIS_URL=redis://localhost:6379/0
